{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["tray"],
    "modules-right": [
        "backlight",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "battery",
        "custom/sep",
        "network",
        "custom/sep",
        "temperature",
        "custom/sep",
        "memory",
        "custom/sep",
        "cpu",
        "custom/sep",
        "clock"
    ],

    "custom/sep": {
        "format": "|",
        "tooltip": false
    },

    "backlight": {
        "format": "BRIGHT: {percent}%"
    },

    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "VOL: MUTED"
    },

    "cpu": {
        "interval": 5,
        "format": "CPU: {usage}%",
        "tooltip": true
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "BAT: {capacity}%",
        "format-plugged": "BAT: {capacity}% "
    },

    "network": {
        "format-wifi": "W: {essid}",
        "format-ethernet": "W: ETH",
        "format-disconnected": "W: DISCONNECTED",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "TEMP: {temperatureC}°C"
    },

    "memory": {
        "format": "RAM: {used:0.1f}G / {total:0.1f}G",
        "interval": 3
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}"
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    }
}
