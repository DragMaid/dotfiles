{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["tray"],
    "modules-right": [
        "backlight",
        "pulseaudio",
        "battery",
        "network",
        "temperature",
        "memory",
        "cpu",
        "clock"
    ],

    "backlight": {
        "format": "{percent}% "
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "MUTED ", 
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        }
    },

    "cpu": {
        "interval": 10,
        "format": "{usage}%  ",
        "tooltip": true
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": "{essid} ",
        "format-ethernet": "ETH ",
        "format-disconnected": "DISCONNECTED ⚠",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C "
    },

    "memory": {
        "format": "RAM: {used:0.1f}G / {total:0.1f}G ",
        "interval": 3
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M}"
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10
    }
}
